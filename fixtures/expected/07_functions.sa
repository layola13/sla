@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

[MACRO] SLA_ARRAY_FILL_U8 %array_ptr, %value, %length
    call @sa_mem_set(&%array_ptr, %value, %length)
[END_MACRO]
@const SLA_FNPTR_VT_fact = vtable { call = @sla__fact }
@const SLA_FNPTR_VT_add = vtable { call = @sla__add }
@const SLA_FNPTR_VT_main = vtable { call = @main }
@sla__fact(n: i32) -> i32:
L_ENTRY:
    tmp_0 = 1
    tmp_1 = sle n, tmp_0
    !tmp_0
    br tmp_1 -> L_THEN_0, L_ELSE_1

L_THEN_0:
    !tmp_1
    tmp_2 = 1
    tmp_3 = 32
    tmp_4 = shl tmp_2, tmp_3
    tmp_5 = ashr tmp_4, tmp_3
    !tmp_2
    !tmp_4
    !tmp_3
    !n
    return tmp_5

L_ELSE_1:
    !tmp_1
    tmp_6 = 1
    tmp_7 = sub n, tmp_6
    !tmp_6
    tmp_8 = 32
    tmp_9 = shl tmp_7, tmp_8
    tmp_10 = ashr tmp_9, tmp_8
    !tmp_7
    !tmp_9
    !tmp_8
    tmp_11 = call @sla__fact(tmp_10)
    !tmp_10
    tmp_12 = mul n, tmp_11
    !tmp_11
    tmp_13 = 32
    tmp_14 = shl tmp_12, tmp_13
    tmp_15 = ashr tmp_14, tmp_13
    !tmp_12
    !tmp_14
    !tmp_13
    !n
    return tmp_15


@sla__add(a: i32, b: i32) -> i32:
L_ENTRY:
    tmp_17 = add a, b
    tmp_18 = 32
    tmp_19 = shl tmp_17, tmp_18
    tmp_20 = ashr tmp_19, tmp_18
    !tmp_17
    !tmp_19
    !tmp_18
    !a
    !b
    return tmp_20

@main() -> i32:
L_ENTRY:
    tmp_21 = 5
    tmp_22 = 32
    tmp_23 = shl tmp_21, tmp_22
    tmp_24 = ashr tmp_23, tmp_22
    !tmp_21
    !tmp_23
    !tmp_22
    tmp_25 = call @sla__fact(tmp_24)
    !tmp_24
    tmp_26 = call @sa_fmt_i64(tmp_25, 10)
    tmp_27 = call @sa_fmt_buffer_data(tmp_26)
    tmp_28 = call @sa_fmt_buffer_len(tmp_26)
    tmp_29 = tmp_27
    call @sa_print_bytes(&tmp_29, tmp_28)
    call @sa_fmt_buffer_free(^tmp_26)
    !tmp_29
    !tmp_28
    !tmp_25
    @const SLA_STR_0 = utf8:"\n"
    call @sa_print_bytes(&SLA_STR_0, 1)
    tmp_30 = 40
    tmp_31 = 32
    tmp_32 = shl tmp_30, tmp_31
    tmp_33 = ashr tmp_32, tmp_31
    !tmp_30
    !tmp_32
    !tmp_31
    tmp_34 = 2
    tmp_35 = 32
    tmp_36 = shl tmp_34, tmp_35
    tmp_37 = ashr tmp_36, tmp_35
    !tmp_34
    !tmp_36
    !tmp_35
    tmp_38 = call @sla__add(tmp_33, tmp_37)
    !tmp_33
    !tmp_37
    tmp_39 = call @sa_fmt_i64(tmp_38, 10)
    tmp_40 = call @sa_fmt_buffer_data(tmp_39)
    tmp_41 = call @sa_fmt_buffer_len(tmp_39)
    tmp_42 = tmp_40
    call @sa_print_bytes(&tmp_42, tmp_41)
    call @sa_fmt_buffer_free(^tmp_39)
    !tmp_42
    !tmp_41
    !tmp_38
    @const SLA_STR_1 = utf8:"\n"
    call @sa_print_bytes(&SLA_STR_1, 1)
    tmp_43 = 0
    tmp_44 = 32
    tmp_45 = shl tmp_43, tmp_44
    tmp_46 = ashr tmp_45, tmp_44
    !tmp_43
    !tmp_45
    !tmp_44
    return tmp_46

@test "basic 07 functions recursion"():
L_TEST_ENTRY_3:
    tmp_47 = 5
    tmp_48 = 32
    tmp_49 = shl tmp_47, tmp_48
    tmp_50 = ashr tmp_49, tmp_48
    !tmp_47
    !tmp_49
    !tmp_48
    tmp_51 = call @sla__fact(tmp_50)
    !tmp_50
    tmp_52 = 120
    tmp_53 = ne tmp_51, tmp_52
    !tmp_51
    !tmp_52
    br tmp_53 -> L_THEN_4, L_ELSE_5

L_THEN_4:
    !tmp_53
    panic(701)

L_ELSE_5:
    !tmp_53
    jmp L_MERGE_6

L_MERGE_6:
    tmp_56 = 0
    tmp_57 = 32
    tmp_58 = shl tmp_56, tmp_57
    tmp_59 = ashr tmp_58, tmp_57
    !tmp_56
    !tmp_58
    !tmp_57
    tmp_60 = call @sla__fact(tmp_59)
    !tmp_59
    tmp_61 = 1
    tmp_62 = ne tmp_60, tmp_61
    !tmp_60
    !tmp_61
    br tmp_62 -> L_THEN_7, L_ELSE_8

L_THEN_7:
    !tmp_62
    panic(702)

L_ELSE_8:
    !tmp_62
    jmp L_MERGE_9

L_MERGE_9:
    tmp_65 = 40
    tmp_66 = 32
    tmp_67 = shl tmp_65, tmp_66
    tmp_68 = ashr tmp_67, tmp_66
    !tmp_65
    !tmp_67
    !tmp_66
    tmp_69 = 2
    tmp_70 = 32
    tmp_71 = shl tmp_69, tmp_70
    tmp_72 = ashr tmp_71, tmp_70
    !tmp_69
    !tmp_71
    !tmp_70
    tmp_73 = call @sla__add(tmp_68, tmp_72)
    !tmp_68
    !tmp_72
    tmp_74 = 42
    tmp_75 = ne tmp_73, tmp_74
    !tmp_73
    !tmp_74
    br tmp_75 -> L_THEN_10, L_ELSE_11

L_THEN_10:
    !tmp_75
    panic(703)

L_ELSE_11:
    !tmp_75
    jmp L_MERGE_12

L_MERGE_12:
    return

