@test "basic 02 arith precedence"():
L_TEST_ENTRY_0:
    tmp_66 = 2
    tmp_67 = 3
    tmp_68 = 4
    tmp_69 = mul tmp_67, tmp_68
    !tmp_67
    !tmp_68
    tmp_70 = add tmp_66, tmp_69
    !tmp_66
    !tmp_69
    tmp_71 = 14
    tmp_72 = ne tmp_70, tmp_71
    !tmp_70
    !tmp_71
    br tmp_72 -> L_THEN_1, L_ELSE_2

L_THEN_1:
    !tmp_72
    panic(201)

L_ELSE_2:
    !tmp_72
    jmp L_MERGE_3

L_MERGE_3:
    tmp_75 = 20
    tmp_76 = 8
    tmp_77 = sub tmp_75, tmp_76
    !tmp_75
    !tmp_76
    tmp_78 = 3
    tmp_79 = sdiv tmp_77, tmp_78
    !tmp_77
    !tmp_78
    tmp_80 = 4
    tmp_81 = ne tmp_79, tmp_80
    !tmp_79
    !tmp_80
    br tmp_81 -> L_THEN_4, L_ELSE_5

L_THEN_4:
    !tmp_81
    panic(202)

L_ELSE_5:
    !tmp_81
    jmp L_MERGE_6

L_MERGE_6:
    tmp_84 = 17
    tmp_85 = 5
    tmp_86 = srem tmp_84, tmp_85
    !tmp_84
    !tmp_85
    tmp_87 = 2
    tmp_88 = ne tmp_86, tmp_87
    !tmp_86
    !tmp_87
    br tmp_88 -> L_THEN_7, L_ELSE_8

L_THEN_7:
    !tmp_88
    panic(203)

L_ELSE_8:
    !tmp_88
    jmp L_MERGE_9

L_MERGE_9:
    tmp_91 = 0
    tmp_92 = 2
    tmp_93 = 3
    tmp_94 = add tmp_92, tmp_93
    !tmp_92
    !tmp_93
    tmp_95 = sub tmp_91, tmp_94
    !tmp_91
    !tmp_94
    tmp_96 = 0
    tmp_97 = 5
    tmp_98 = sub tmp_96, tmp_97
    !tmp_96
    !tmp_97
    tmp_99 = ne tmp_95, tmp_98
    !tmp_95
    !tmp_98
    br tmp_99 -> L_THEN_10, L_ELSE_11

L_THEN_10:
    !tmp_99
    panic(204)

L_ELSE_11:
    !tmp_99
    jmp L_MERGE_12

L_MERGE_12:
    tmp_102 = call @sla__arith_values()
    tmp_103 = 14
    tmp_104 = 40
    tmp_105 = add tmp_103, tmp_104
    !tmp_103
    !tmp_104
    tmp_106 = 200
    tmp_107 = add tmp_105, tmp_106
    !tmp_105
    !tmp_106
    tmp_108 = 5
    tmp_109 = sub tmp_107, tmp_108
    !tmp_107
    !tmp_108
    tmp_110 = ne tmp_102, tmp_109
    !tmp_102
    !tmp_109
    br tmp_110 -> L_THEN_13, L_ELSE_14

L_THEN_13:
    !tmp_110
    panic(205)

L_ELSE_14:
    !tmp_110
    jmp L_MERGE_15

L_MERGE_15:
    return

