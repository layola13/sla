@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

[MACRO] SLA_ARRAY_FILL_U8 %array_ptr, %value, %length
    call @sa_mem_set(&%array_ptr, %value, %length)
[END_MACRO]
@const SLA_FNPTR_VT_max = vtable { call = @sla__max }
@const SLA_FNPTR_VT_main = vtable { call = @main }
@sla__max(a: i32, b: i32) -> i32:
L_ENTRY:
    tmp_0 = sgt a, b
    tmp_1 = alloc 4
    br tmp_0 -> L_THEN_0, L_ELSE_1

L_THEN_0:
    !tmp_0
    tmp_2 = add a, 0
    store tmp_1+0, tmp_2 as i32
    !tmp_2
    jmp L_MERGE_2

L_ELSE_1:
    !tmp_0
    tmp_3 = add b, 0
    store tmp_1+0, tmp_3 as i32
    !tmp_3
    jmp L_MERGE_2

L_MERGE_2:
    tmp_4 = load tmp_1+0 as i32
    !tmp_1
    tmp_5 = 32
    tmp_6 = shl tmp_4, tmp_5
    tmp_7 = ashr tmp_6, tmp_5
    !tmp_4
    !tmp_6
    !tmp_5
    !a
    !b
    return tmp_7

@main() -> i32:
L_ENTRY:
    tmp_8 = 7
    tmp_9 = 32
    tmp_10 = shl tmp_8, tmp_9
    tmp_11 = ashr tmp_10, tmp_9
    !tmp_8
    !tmp_10
    !tmp_9
    tmp_12 = 42
    tmp_13 = 32
    tmp_14 = shl tmp_12, tmp_13
    tmp_15 = ashr tmp_14, tmp_13
    !tmp_12
    !tmp_14
    !tmp_13
    tmp_16 = call @sla__max(tmp_11, tmp_15)
    !tmp_11
    !tmp_15
    tmp_17 = call @sa_fmt_i64(tmp_16, 10)
    tmp_18 = call @sa_fmt_buffer_data(tmp_17)
    tmp_19 = call @sa_fmt_buffer_len(tmp_17)
    tmp_20 = tmp_18
    call @sa_print_bytes(&tmp_20, tmp_19)
    call @sa_fmt_buffer_free(^tmp_17)
    !tmp_20
    !tmp_19
    !tmp_16
    @const SLA_STR_0 = utf8:"\n"
    call @sa_print_bytes(&SLA_STR_0, 1)
    tmp_21 = 0
    tmp_22 = 3
    tmp_23 = sub tmp_21, tmp_22
    !tmp_21
    !tmp_22
    tmp_24 = 32
    tmp_25 = shl tmp_23, tmp_24
    tmp_26 = ashr tmp_25, tmp_24
    !tmp_23
    !tmp_25
    !tmp_24
    tmp_27 = 0
    tmp_28 = 9
    tmp_29 = sub tmp_27, tmp_28
    !tmp_27
    !tmp_28
    tmp_30 = 32
    tmp_31 = shl tmp_29, tmp_30
    tmp_32 = ashr tmp_31, tmp_30
    !tmp_29
    !tmp_31
    !tmp_30
    tmp_33 = call @sla__max(tmp_26, tmp_32)
    !tmp_26
    !tmp_32
    tmp_34 = call @sa_fmt_i64(tmp_33, 10)
    tmp_35 = call @sa_fmt_buffer_data(tmp_34)
    tmp_36 = call @sa_fmt_buffer_len(tmp_34)
    tmp_37 = tmp_35
    call @sa_print_bytes(&tmp_37, tmp_36)
    call @sa_fmt_buffer_free(^tmp_34)
    !tmp_37
    !tmp_36
    !tmp_33
    @const SLA_STR_1 = utf8:"\n"
    call @sa_print_bytes(&SLA_STR_1, 1)
    tmp_38 = 0
    tmp_39 = 32
    tmp_40 = shl tmp_38, tmp_39
    tmp_41 = ashr tmp_40, tmp_39
    !tmp_38
    !tmp_40
    !tmp_39
    return tmp_41

@test "basic 03 max branches"():
L_TEST_ENTRY_3:
    tmp_42 = 7
    tmp_43 = 32
    tmp_44 = shl tmp_42, tmp_43
    tmp_45 = ashr tmp_44, tmp_43
    !tmp_42
    !tmp_44
    !tmp_43
    tmp_46 = 42
    tmp_47 = 32
    tmp_48 = shl tmp_46, tmp_47
    tmp_49 = ashr tmp_48, tmp_47
    !tmp_46
    !tmp_48
    !tmp_47
    tmp_50 = call @sla__max(tmp_45, tmp_49)
    !tmp_45
    !tmp_49
    tmp_51 = 42
    tmp_52 = ne tmp_50, tmp_51
    !tmp_50
    !tmp_51
    br tmp_52 -> L_THEN_4, L_ELSE_5

L_THEN_4:
