@import "sa_std/string.sa"
@import "sa_std/string_format.sa"
@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/core/panic.sa"

[MACRO] SLA_ARRAY_FILL_U8 %array_ptr, %value, %length
    call @sa_mem_set(&%array_ptr, %value, %length)
[END_MACRO]
@const SLA_FNPTR_VT_arith_values = vtable { call = @sla__arith_values }
@const SLA_FNPTR_VT_main = vtable { call = @main }
@sla__arith_values() -> i32:
L_ENTRY:
    tmp_0 = 2
    tmp_1 = 3
    tmp_2 = 4
    tmp_3 = mul tmp_1, tmp_2
    !tmp_1
    !tmp_2
    tmp_4 = add tmp_0, tmp_3
    !tmp_0
    !tmp_3
    a = add tmp_4, 0
    !tmp_4
    tmp_5 = 20
    tmp_6 = 8
    tmp_7 = sub tmp_5, tmp_6
    !tmp_5
    !tmp_6
    tmp_8 = 3
    tmp_9 = sdiv tmp_7, tmp_8
    !tmp_7
    !tmp_8
    b = add tmp_9, 0
    !tmp_9
    tmp_10 = 17
    tmp_11 = 5
    tmp_12 = srem tmp_10, tmp_11
    !tmp_10
    !tmp_11
    c = add tmp_12, 0
    !tmp_12
    tmp_13 = 0
    tmp_14 = 2
    tmp_15 = 3
    tmp_16 = add tmp_14, tmp_15
    !tmp_14
    !tmp_15
    tmp_17 = sub tmp_13, tmp_16
    !tmp_13
    !tmp_16
    d = add tmp_17, 0
    !tmp_17
    tmp_18 = 10
    tmp_19 = mul b, tmp_18
    !tmp_18
    tmp_20 = add a, tmp_19
    !tmp_19
    tmp_21 = 100
    tmp_22 = mul c, tmp_21
    !tmp_21
    tmp_23 = add tmp_20, tmp_22
    !tmp_20
    !tmp_22
    tmp_24 = add tmp_23, d
    !tmp_23
    !a
    !b
    !c
    !d
    return tmp_24

@main() -> i32:
L_ENTRY:
    tmp_25 = call @sla__arith_values()
    return tmp_25

@test "probe arith"():
L_TEST_ENTRY_0:
    tmp_26 = call @sla__arith_values()
    tmp_27 = 249
    tmp_28 = ne tmp_26, tmp_27
    !tmp_26
    !tmp_27
    br tmp_28 -> L_THEN_1, L_ELSE_2

L_THEN_1:
    !tmp_28
    panic(205)

L_ELSE_2:
    !tmp_28
    jmp L_MERGE_3

L_MERGE_3:
    return

