// SPRINT-100 L5 minim: a composed type alias denotes the
// flattened struct of its components' fields. On the base
// tree pass 1 registered only single-type aliases, so the
// composed name resolved nowhere and construction failed
// NotAStruct.

struct S100Pos {
    x: i64,
    y: i64,
}

struct S100Vel {
    dx: i64,
    dy: i64,
}

type S100Body = S100Pos & S100Vel & { hp: i32};

@test "s100 alias flatten minim"() {
    let b = S100Body { x: 1, y: 2, dx: 3, dy: 4, hp: 9 };
    if b.x + b.y + b.dx + b.dy != 10 { panic(10081); };
    if b.hp != 9 { panic(10082); };
}
