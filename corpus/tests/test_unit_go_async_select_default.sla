// Regression (LINE-GO-FAMILY): a NON-blocking select (with a
// default arm) inside an async fn is legal -- Zig
// type_checker.zig checkSelectStmt forbids only a blocking
// select (no default and no timeout) in an async fn (R2). The
// Rust checker rejected every select in an async fn
// (GoAsyncSelect), which failed test_unit_go_async_interop.

@import "sa_std/globals.sai"
@import "sa_std/async.sla"
@import "sa_std/task.sai"

async fn gasd_probe(ch: Chan<u64>) -> i32 {
    select {
        case let (v, closed) = ch.recv() {
            return 1;
        }
        default {
            return 0;
        }
    }
}

fn gasd_drive(arg: u64) {
    let ch: Chan<u64> = Chan::new(1);
    let first = sched_block_on_timeout(gasd_probe(ch), 10000);
    let rc1 = sa_global_u64_set("gasd_first", 8, first as u64);
    if rc1 != 0 { panic(9301); };
    ch.send(9);
    let second = sched_block_on_timeout(gasd_probe(ch), 10000);
    let rc2 = sa_global_u64_set("gasd_second", 8, second as u64);
    if rc2 != 0 { panic(9302); };
    ch.destroy();
}

@test "non-blocking select with default is legal in async fn"() {
    let h = go gasd_drive(0);
    let status = sa_task_join(h);
    if status != 0 { panic(9303); };
    let f: u64 = 0;
    let rc1 = sa_global_u64_get("gasd_first", 8, &f);
    if rc1 != 0 { panic(9304); };
    if f != 0 { panic(9305); };
    let s: u64 = 0;
    let rc2 = sa_global_u64_get("gasd_second", 8, &s);
    if rc2 != 0 { panic(9306); };
    if s != 1 { panic(9307); };
}
