// Regression oracle (LINE-RCDYN-FIX, F-DYN L1): the d2 shape in a
// plain fn body, so `sla check` (which does not check @test
// bodies) judges the checker layer directly. Fail-before:
// `sla check` rc=1, `Undefined call: get_id`. Pass-after: rc=0.
// Probe c2 of LINE-RCDYN-TRIAGE.
@import "sa_std/core/rc.sa"
@import "sa_std/core/trait_object.sa"

trait Identified {
    fn get_id(&self) -> int;
}

struct TypeA {
    id: int,
}

impl Identified for TypeA {
    fn get_id(&self) -> int {
        return self.id;
    }
}

fn probe_direct() -> int {
    let obj: Rc<dyn Identified> = Rc::new(TypeA { id: 42 });
    return obj.get_id();
}

@test "rc dyn check direct"() {
    if probe_direct() != 42 {
        panic(2);
    };
}
