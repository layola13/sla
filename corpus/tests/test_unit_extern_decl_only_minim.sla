// S100 minim: decl-only (extern) function declarations must emit
// `@extern` declarations instead of failing the whole program
// emission (codegen.zig emitExternDecl). Two shapes: a prototype
// paired with a concrete @no_mangle definition (decl skipped), and
// a declared-but-never-called prototype (decl emitted).

extern "C" {
    fn ext_minim_double(x: i32) -> i32;
    fn ext_minim_never_called(x: i32) -> i32;
}

@no_mangle pub extern "C" fn ext_minim_double(x: i32) -> i32 {
    return x * 2;
}

@test "extern decl only minim"() {
    let r = unsafe { ext_minim_double(21) };
    if r != 42 { panic(7701); };
}
