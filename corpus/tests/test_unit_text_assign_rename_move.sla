// Stage-3 F1-adjacent regression: a plain register rename of
// a non-primitive identifier source is a host-level move; the
// source binding must be marked consumed so the loop-body
// cleanup does not release it a second time (UseAfterMove on
// `!next` before the fix).

struct Boxed { value: i32 }

fn step(input: Boxed) -> Boxed {
    return Boxed { value: input.value + 1 };
}

fn run_n(boxed: Boxed, n: i32) -> Boxed {
    let i: i32 = 0;
    while i < n {
        let next = step(boxed);
        boxed = next;
        i = i + 1;
    }
    return boxed;
}

@test "text assign rename move cleanup"() {
    let out = run_n(Boxed { value: 1 }, 3);
    if out.value != 4 { panic(9501); };
}
