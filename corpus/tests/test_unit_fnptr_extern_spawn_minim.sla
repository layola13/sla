// Regression minim: bare fn name passed directly to an extern
// by-value `ptr` parameter (pthread_spawn_detached's entry).
//
// An SLA fn value's bits are the address of its SLA_FNPTR_VT_<fn>
// vtable (data); the callable machine address is vtable slot 0.
// The call-argument materialization for this shape must load
// slot 0 (Zig lowering_rules.zig `callArgIsExternFnPtrAddress` /
// codegen.zig ExternFnPtrAddress arm). Without it the vtable bits
// reach the native callee and the spawned thread jumps into data:
// the test is terminated by signal 11. The cast forms
// (`fn as ptr`) already loaded slot 0 and passed; only the direct
// forms (bare name / fn-typed local / wrapper param) died — this
// minim pins the bare-name form. Full shape coverage lives in
// test_unit_fn_ptr_extern.sla.

@import "sa_std/thread.sai"
@import "sa_std/globals.sai"
@import "sa_std/string.sa"
@import "sa_std/time.sai"

fn fnptr_ext_min_cell(name: ptr, name_len: u64) -> u64 {
    let v: u64 = 0;
    let rc: i32 = sa_global_u64_get(name, name_len, &v);
    if rc != 0 { return 0; };
    return v;
}

fn fnptr_ext_min_wait(name: ptr, name_len: u64, want: u64) -> bool {
    let i: i32 = 0;
    while i < 400 {
        if fnptr_ext_min_cell(name, name_len) == want { return true; };
        if sa_time_sleep_ms(5) != 0 { return false; };
        i = i + 1;
    }
    return fnptr_ext_min_cell(name, name_len) == want;
}

fn fnptr_ext_min_worker(arg: ptr) {
    let out: u64 = 0;
    let rc: i32 = sa_global_u64_add(STR_PTR("fnptr.ext.min"), STR_LEN("fnptr.ext.min"), 1, &out);
}

@test "bare fn name passed to extern ptr param spawns callable thread"() {
    if sa_global_u64_set(STR_PTR("fnptr.ext.min"), STR_LEN("fnptr.ext.min"), 0) != 0 { panic(7101); };
    let dummy: u64 = 0;
    if pthread_spawn_detached(fnptr_ext_min_worker, &dummy) != 0 { panic(7102); };
    if !fnptr_ext_min_wait(STR_PTR("fnptr.ext.min"), STR_LEN("fnptr.ext.min"), 1) { panic(7103); };
}
