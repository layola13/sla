@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/string.sa"

// S100 minim: single-argument `println` of a format-string / String
// value prints the value's bytes plus a newline (codegen.zig:2140,
// emitPrintln #4b value paths), instead of failing emission.

fn main() -> i32 {
    println(format("m={}", 4));
    return 0;
}

@test "println string value minim"() {
    let s = format("k={}", 2);
    println(s);
    if !str_eq(s, "k=2") {
        panic(7702);
    };
    println(`v=${7}`);
}
