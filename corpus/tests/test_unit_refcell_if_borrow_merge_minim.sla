@import "sa_std/core/refcell.sa"
@import "import_fixtures/imported_refcell_helpers.sa"

struct MinimPayload {
    value: int,
}

fn minim_borrow_count(cell: &RefCell<MinimPayload>) -> i64 {
    SLA_REFCELL_BORROW_COUNT(cell)
}

fn minim_if_borrow_count(flag: bool) -> i64 {
    let left = RefCell::new(MinimPayload { value: 71 });
    let right = RefCell::new(MinimPayload { value: 83 });
    let picked: &MinimPayload = if flag {
        left.borrow()
    } else {
        right.borrow()
    };
    if picked.value == 0 {
        panic(12);
    };
    if flag {
        return minim_borrow_count(&left);
    };
    return minim_borrow_count(&right);
}

@test "if-expression refcell borrow merges handle"() {
    if minim_if_borrow_count(true) != 1 { panic(106); };
    if minim_if_borrow_count(false) != 1 { panic(107); };
}
