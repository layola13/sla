@import "sa_std/vec.sa"
@import "sa_std/ptr.sa"
@import "sa_std/core/slice.sa"

// LINE-DEEP minim (DEF-deep-copy): the explicit `.clone()` surface
// for a user struct and for a Vec receiver produces a deep,
// independent value; the source stays fully usable. Pre-fix the
// text codegen fell through to the bare-name EXPAND catch-all and
// emitted `EXPAND clone`, a macro defined in no std tree (host
// UndefinedMacro 1060).

struct DeepMin { xs: Vec<u8>, n: i32 }

@test "deep clone minim struct clone is field deep"() {
    let a: DeepMin = DeepMin { xs: Vec::new(), n: 7 };
    a.xs.push(200 as u8);
    let b: DeepMin = a.clone();
    b.xs.push(201 as u8);
    if a.xs.len() != 1 { panic(2951); };
    if b.xs.len() != 2 { panic(2952); };
    if b.n != 7 { panic(2953); };
}

@test "deep clone minim vec clone is independent"() {
    let v: Vec<u8> = Vec::new();
    v.push(200 as u8);
    let w: Vec<u8> = v.clone();
    w.push(201 as u8);
    if v.len() != 1 { panic(2941); };
    if w.len() != 2 { panic(2942); };
}
