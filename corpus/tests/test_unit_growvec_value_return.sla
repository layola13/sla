@import "sa_std/growvec.sa"

// Positive control for the borrow-escape return gate: returning
// an element VALUE is fine, and returning a borrow rooted at a
// borrow parameter is fine — only a borrow of a function-local
// owned binding is an escape (test_error_growvec_ref_escape).
fn growvec_first_value() -> u64 {
    let g: GrowVec<u64> = GrowVec::new();
    g.push(41);
    return g[0];
}

fn borrow_of_param_first(v: &Vec<u64>) -> &u64 {
    return &v[0];
}

@test "growvec value return and param borrow return are legal"() {
    if growvec_first_value() != 41 { panic(1); };
    let v: Vec<u64> = Vec::new();
    v.push(7);
    let r = borrow_of_param_first(&v);
    if *r != 7 { panic(2); };
}
